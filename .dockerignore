# ========================================
# 1. ビルドを激重にする元凶 (Docker特有の設定！)
# ========================================
.git
.gitignore
README.md

# ========================================
# 2. セキュリティ・機密情報 (イメージにパスワードを焼き付けない！)
# ========================================
.env
*.key
*.pem
credentials.json

# ========================================
# 3. ローカルPC専用の仮想環境 (コンテナ内のPythonと競合してバグる原因)
# ========================================
.venv/
.venv*/
venv*/
ENV/

# ========================================
# 4. AIモデル・重みデータ (ビルドのたびに数GBを転送してPCがフリーズするのを防ぐ)
# ========================================
*.pt
*.onnx
yolo*.pt
staff_features.pt
visitor_features.pt

# ========================================
# 5. ローカルでの実行ログ・出力データ
# ========================================
runs/
logs/
*.log
*.csv
dwell_log.csv
test_movie/
__pycache__/

# ========================================
# 6. OS・エディタの自動生成ファイル
# ========================================
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ========================================
# 7. Python標準のキャッシュ・ビルド用ゴミ箱
# ========================================
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg